        </div>
        <span>|</span>
        <span id="ultimaAtualizacao">Última atualização: --:--:--</span>
    </footer>

    <script>
        const loteValue = document.getElementById('loteValue');
        const loteDisplayArea = document.getElementById('loteDisplayArea');
        const loteInputArea = document.getElementById('loteInputArea');
        const loteInput = document.getElementById('loteInput');
        const btnAlterar = document.getElementById('btnAlterar');
        const btnSalvar = document.getElementById('btnSalvar');
        
        const dataHojeEl = document.getElementById('dataHoje');
        const venc21El = document.getElementById('venc21');
        const venc30El = document.getElementById('venc30');
        const venc15El = document.getElementById('venc15');
        const venc11El = document.getElementById('venc11');
        const ultimaAtualizacaoEl = document.getElementById('ultimaAtualizacao');
        const btnFullscreen = document.getElementById('btnFullscreen');

        const STORAGE_KEY = 'controle_lote_numero';

        function carregarLote() {
            const loteSalvo = localStorage.getItem(STORAGE_KEY);
            if (loteSalvo && loteSalvo.trim() !== '') {
                loteValue.textContent = loteSalvo.toUpperCase();
            } else {
                loteValue.textContent = '000';
            }
        }

        btnAlterar.addEventListener('click', () => {
            const atual = loteValue.textContent;
            loteInput.value = atual === '000' ? '' : atual;
            loteDisplayArea.style.display = 'none';
            loteInputArea.style.display = 'flex';
            loteInput.focus();
            loteInput.select();
        });

        function salvarLote() {
            let novoLote = loteInput.value.trim();
            if (novoLote === '') {
                novoLote = '000';
            }
            localStorage.setItem(STORAGE_KEY, novoLote);
            loteValue.textContent = novoLote.toUpperCase();
            loteInputArea.style.display = 'none';
            loteDisplayArea.style.display = 'flex';
        }

        btnSalvar.addEventListener('click', salvarLote);

        loteInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                salvarLote();
            }
        });

        function formatarData(data) {
            const dia = String(data.getDate()).padStart(2, '0');
            const mes = String(data.getMonth() + 1).padStart(2, '0');
            const ano = data.getFullYear();
            return `${dia}/${mes}/${ano}`;
        }

        function adicionarDias(dataBase, dias) {
            const novaData = new Date(dataBase.getTime());
            novaData.setDate(novaData.getDate() + dias);
            return novaData;
        }

        function atualizarSistema() {
            const agora = new Date();
            
            dataHojeEl.textContent = formatarData(agora);

            venc21El.textContent = formatarData(adicionarDias(agora, 21));
            venc30El.textContent = formatarData(adicionarDias(agora, 30));
            venc15El.textContent = formatarData(adicionarDias(agora, 15));
            venc11El.textContent = formatarData(adicionarDias(agora, 11));

            const horas = String(agora.getHours()).padStart(2, '0');
            const minutos = String(agora.getMinutes()).padStart(2, '0');
            const segundos = String(agora.getSeconds()).padStart(2, '0');
            ultimaAtualizacaoEl.textContent = `Última atualização: ${horas}:${minutos}:${segundos}`;
        }

        btnFullscreen.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen().catch(err => {
                        console.log("Erro ao tentar entrar em tela cheia:", err);
                    });
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        });

        carregarLote();
        atualizarSistema();

        setInterval(atualizarSistema, 1000);
    </script>
</body>
